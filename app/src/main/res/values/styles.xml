<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.AppTheme.LikeButton" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="iconTint">@color/like_materialbox_tint</item>
        <item name="android:minWidth">@dimen/ic_button_size</item>
        <item name="android:minHeight">@dimen/ic_button_size</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="iconGravity">textEnd</item>
    </style>
    <style name="Widget.AppTheme.PlayButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:backgroundTint">@color/yellow</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Circle</item>
    </style>
    <style name="Widget.AppTheme.HeadingText" parent="Widget.Material3.TextView.ListItem.LabelText">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>